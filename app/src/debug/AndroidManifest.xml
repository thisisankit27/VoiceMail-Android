<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only test hooks. Never part of a release build. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- ADB command channel. DUMP is held by the ADB shell, not by third-party apps. -->
        <receiver
            android:name=".debug.DebugCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Network-free calling account for loopback test calls (no modem, no carrier). -->
        <service
            android:name=".debug.LoopbackConnectionService"
            android:exported="true"
            android:permission="android.permission.BIND_TELECOM_CONNECTION_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.ConnectionService" />
            </intent-filter>
        </service>
    </application>
</manifest>
